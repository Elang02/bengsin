{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "public/**"
        ]
      }
    }
  ],
  "crons": [
    {
      "path": "/cron/fuel-sync",
      "schedule": "0 22 * * *"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
